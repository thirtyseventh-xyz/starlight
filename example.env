#WARNING: if youre using the docker run command to run this, youll need to remove the quotes. the env parser for run
#is annoying and doesnt like them. just use your editor's dockerfile testing, or just run the flask app in dev mode if
#you didnt change stuff with docker. dont be me and spend 45 minutes debugging env parsing issues - 37

PROD_MAIN_URL="http://localhost:5000" #should probably just leave this

HCA_OAUTH_REDIRECT_URI="http://localhost:5000/auth/callback"
HCA_OAUTH_CLIENT_ID="get_this_from_hca"
HCA_OAUTH_CLIENT_SECRET="get_this_from_hca"
DISABLE_OAUTH="false"

FLASK_SECRET_KEY="replace_me" #generate with openssl rand --hex 64

FILLOUT_API_KEY="get_this_from_zook"
FILLOUT_FORM_ID="get_this_from_zook"

ENCRYPTION_KEY="replace_me"#generate with openssl rand --hex 64

POSTGRES_IP="localhost:5432" #spin up a postgres container with docker or something
POSTGRES_USER="replace_me"
POSTGRES_PASSWORD="replace_me"
POSTGRES_DB="starlight-dev"

HACKATIME_OAUTH_REDIRECT_URI="http://localhost:5000/auth/hackatime/callback" #leave the path the same, just change the domain if you need
HACKATIME_OAUTH_CLIENT_ID="get_this_from_hackatime"
HACKATIME_OAUTH_CLIENT_SECRET="get_this_from_hackatime"

